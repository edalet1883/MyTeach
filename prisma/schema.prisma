generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/custom.db"
}

// ─────────────────────────────────────────────
//  MyTeach — Müəllim və Şagird Platforması
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  surname      String
  email        String   @unique
  phone        String
  password     String
  role         String   @default("STUDENT") // STUDENT | TEACHER | ADMIN
  age          Int?
  // Cins: FEMALE | MALE (yalnız məlumat üçün, filtrlərdə işlənir)
  gender       String?
  emailVerified Boolean @default(false)
  verifyToken  String?
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  teacherProfile TeacherProfile?
  reviews        Review[]
  favorites      Favorite[]
}

model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  bio             String?
  experienceYears Int      @default(0)
  pricePerHour    Int      @default(0)
  // Qiymət dövrü: HOUR | DAY | MONTH | YEAR
  pricePeriod     String   @default("HOUR")
  diplomaUrl      String?
  // PENDING → EMAIL_VERIFIED(WAITING_ADMIN) → APPROVED | REJECTED
  status          String   @default("PENDING")

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  sectorId  String?
  sector    Sector?  @relation(fields: [sectorId], references: [id])
  purposeId String?
  purpose   Purpose? @relation(fields: [purposeId], references: [id])
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])

  whatsapp     String?
  phoneContact String?
  emailContact String?
  showWhatsapp Boolean @default(false)
  showPhone    Boolean @default(false)
  showEmail    Boolean @default(false)

  // Dərs forması: ONLINE | IN_PERSON | BOTH
  lessonFormats String @default("BOTH")

  // Qrup dərsləri
  groupLessons Boolean @default(false)
  groupPrice   Int?

  // 👑 VIP — admin təsdiqilən premium anket
  isVip        Boolean @default(false)
  vipRequested Boolean @default(false)
  vipPlan      String? // MONTH | QUARTER | YEAR

  reviews   Review[]
  favorites Favorite[]
  reports   Report[]

  createdAt DateTime @default(now())
}

model Subject {
  id     String @id @default(cuid())
  nameAz String
  nameEn String
  nameRu String
  // Kateqoriya açarı: school | lang | uni | it | design | music | sport | dance | art | biz | child | beauty | law | sci | build | other
  category String?

  teachers TeacherProfile[]
}

model Sector {
  id     String @id @default(cuid())
  nameAz String
  nameEn String
  nameRu String

  teachers TeacherProfile[]
}

model Purpose {
  id     String @id @default(cuid())
  nameAz String
  nameEn String
  nameRu String

  teachers TeacherProfile[]
}

model City {
  id     String @id @default(cuid())
  nameAz String
  nameEn String
  nameRu String

  teachers TeacherProfile[]
}

model Review {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   User           @relation(fields: [studentId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime       @default(now())

  @@unique([teacherId, studentId])
}

model Favorite {
  id        String         @id @default(cuid())
  studentId String
  student   User           @relation(fields: [studentId], references: [id])
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([studentId, teacherId])
}

model Report {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reason    String
  comment   String?
  status    String         @default("OPEN") // OPEN | RESOLVED
  createdAt DateTime       @default(now())
}
