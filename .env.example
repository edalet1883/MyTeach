# Baza fayl yolu (schema.prisma-yə nisbətən: prisma/db/custom.db)
DATABASE_URL=file:./db/custom.db

# Production üçün tövsiyə olunur:
# AUTH_SECRET=<öz gizli açarınız>

# Real e-poçt göndərişi üçün (nodemailer inteqrasiyasından sonra):
# GMAIL_USER=your@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Telegram bot (yeni müəllim bildirişləri) — @BotFather-dən alınır:
# BOT_TOKEN=123456:ABC-xxxx
# ADMIN_TELEGRAM_ID=123456789  (@userinfobot-dan öz id-nizi öyrənin)
# TELEGRAM_WEBHOOK_SECRET=təsadüfi-gizli-söz  (webhook təhlükəsizliyi)
